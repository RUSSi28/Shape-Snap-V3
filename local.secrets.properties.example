# このファイルをコピーして local.secrets.properties を作成し、実値を入れてください。
# cp local.secrets.properties.example local.secrets.properties
#
# Google Sign-In (Credential Manager) 用 Web クライアント ID。
# Firebase コンソールの OAuth 2.0 クライアント ID（Web）を設定してください。
# google-services.json の client_type:3 (web) の client_id と一致させる必要があります。
GOOGLE_WEB_CLIENT_ID=